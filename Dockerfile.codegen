# syntax=docker/dockerfile:1
#
# The one place code generation happens.
#
# Every version here is pinned. A contributor's host protoc at a different
# version produces subtly different output, the vendored files churn, and the
# diff stops being reviewable -- so the host is never asked to have one. Docker
# is the only prerequisite.
#
# Build with `make codegen`, which exports the result into gen/.

ARG PROTOC_VERSION=29.3
ARG RUST_VERSION=1.90
ARG PYTHON_VERSION=3.12
ARG GRPCIO_TOOLS_VERSION=1.68.1

# ─────────────────────────────────────────────────────────────────────────────
# protoc, and the Python bindings it can emit directly
# ─────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS protoc
ARG PROTOC_VERSION
ARG TARGETARCH
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# protoc publishes aarch_64, not arm64.
RUN case "${TARGETARCH}" in \
      amd64) PROTOC_ARCH=x86_64 ;; \
      arm64) PROTOC_ARCH=aarch_64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/protoc.zip \
      "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip" \
 && unzip -q /tmp/protoc.zip -d /usr/local \
 && chmod +x /usr/local/bin/protoc \
 && rm /tmp/protoc.zip \
 && protoc --version

FROM python:${PYTHON_VERSION}-slim AS python-gen
ARG GRPCIO_TOOLS_VERSION
# grpcio-tools carries its own pinned protoc, so Python generation is
# self-contained and reproducible from this one version.
RUN pip install --no-cache-dir "grpcio-tools==${GRPCIO_TOOLS_VERSION}"
WORKDIR /src
COPY proto/ proto/
RUN mkdir -p /out/python \
 && python -m grpc_tools.protoc -I proto \
      --python_out=/out/python \
      --pyi_out=/out/python \
      --grpc_python_out=/out/python \
      $(find proto -name '*.proto' | sort) \
 && find /out/python -type d -exec touch {}/__init__.py \;
# The package root is `meridian`, so a consumer writes
#   from meridian.v1 import holdings_pb2
# rather than importing a bare `v1` at top level.

# Packaging, so a Python consumer pins a schema revision the way the Rust
# workspace pins meridian-pb. The alternative is a vendored copy in every
# consumer, and a vendored copy is a copy that drifts: the day it does, a plugin
# builds against types the schema does not describe and nothing says so.
#
# Written here rather than committed by hand, because everything under gen/ is
# generated and check-codegen compares a fresh generation against it. A
# hand-added file in that tree is a file the next regeneration deletes.
#
# grpcio is a real dependency, not an optional one: the *_pb2_grpc modules
# import grpc at module scope, so importing the package without it fails.
RUN printf '%s\n' \
  '# Generated by meridian-schema. Do not edit.' \
  '[build-system]' \
  'requires = ["setuptools>=68"]' \
  'build-backend = "setuptools.build_meta"' \
  '' \
  '[project]' \
  'name = "meridian-pb"' \
  'version = "0.1.0"' \
  'description = "Generated Meridian wire types"' \
  'license = { text = "Apache-2.0" }' \
  'requires-python = ">=3.11"' \
  'dependencies = ["protobuf>=5.28,<7", "grpcio>=1.68,<2"]' \
  '' \
  '[tool.setuptools.packages.find]' \
  'include = ["meridian*"]' \
  > /out/python/pyproject.toml

# ─────────────────────────────────────────────────────────────────────────────
# Rust bindings, via prost
# ─────────────────────────────────────────────────────────────────────────────
FROM rust:${RUST_VERSION}-slim-bookworm AS rust-gen
COPY --from=protoc /usr/local/bin/protoc /usr/local/bin/protoc
COPY --from=protoc /usr/local/include/google /usr/local/include/google
WORKDIR /src
COPY codegen/Cargo.toml codegen/Cargo.lock codegen/
COPY codegen/src codegen/src
COPY proto/ proto/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/codegen/target \
    cd codegen && cargo run --release --locked

# ─────────────────────────────────────────────────────────────────────────────
# Does the generated crate actually build?
#
# A build stage rather than a bind-mounted `docker run`: mounting a
# just-created host directory into the VM raced, and cargo intermittently
# failed to create its own target directory. Copying into the image has no
# such window, and makes the check reproducible on any host.
# ─────────────────────────────────────────────────────────────────────────────
FROM rust:${RUST_VERSION}-slim-bookworm AS pb-check
WORKDIR /w
COPY gen/rust/ ./
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/w/target \
    cargo build --release

# ─────────────────────────────────────────────────────────────────────────────
# Does the generated Python package import and round-trip?
#
# Built on python-gen rather than a fresh image, so the protobuf runtime the
# check imports with is the exact one grpcio-tools pinned to generate the code.
# Any other base would introduce a second version to keep in step.
#
# This ran on the host until CI proved the host was the problem: a developer
# machine with protobuf installed passed, a clean runner exited 2 on a missing
# runtime, and the gate's verdict depended on which one ran it.
# ─────────────────────────────────────────────────────────────────────────────
FROM python-gen AS pb-imports
WORKDIR /w
COPY gen/python/ gen/python/
COPY tools/check_pb_imports.py tools/
RUN python3 tools/check_pb_imports.py --gen gen/python

# ─────────────────────────────────────────────────────────────────────────────
# What `make codegen` extracts
# ─────────────────────────────────────────────────────────────────────────────
FROM scratch AS export
COPY --from=python-gen /out/python /python
COPY --from=rust-gen /out/rust /rust
