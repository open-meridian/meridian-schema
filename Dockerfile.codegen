# syntax=docker/dockerfile:1
#
# The one place code generation happens.
#
# Every version here is pinned. A contributor's host protoc at a different
# version produces subtly different output, the vendored files churn, and the
# diff stops being reviewable -- so the host is never asked to have one. Docker
# is the only prerequisite.
#
# Build with `make codegen`, which exports the result into gen/.

ARG PROTOC_VERSION=29.3
ARG RUST_VERSION=1.90

# ─────────────────────────────────────────────────────────────────────────────
# protoc, and the Python bindings it can emit directly
# ─────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS protoc
ARG PROTOC_VERSION
ARG TARGETARCH
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# protoc publishes aarch_64, not arm64.
RUN case "${TARGETARCH}" in \
      amd64) PROTOC_ARCH=x86_64 ;; \
      arm64) PROTOC_ARCH=aarch_64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/protoc.zip \
      "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip" \
 && unzip -q /tmp/protoc.zip -d /usr/local \
 && chmod +x /usr/local/bin/protoc \
 && rm /tmp/protoc.zip \
 && protoc --version

FROM protoc AS python-gen
WORKDIR /src
COPY proto/ proto/
# The protos declare messages and no services, so there is no gRPC plumbing to
# generate. Type stubs come along because they cost nothing and make the
# generated package usable from a type-checked codebase.
RUN mkdir -p /out/python \
 && protoc -I proto \
      --python_out=/out/python \
      --pyi_out=/out/python \
      $(find proto -name '*.proto' | sort) \
 && find /out/python -type d -exec touch {}/__init__.py \;
# The package root is `meridian`, so a consumer writes
#   from meridian.v1 import holdings_pb2
# rather than importing a bare `v1` at top level.

# ─────────────────────────────────────────────────────────────────────────────
# Rust bindings, via prost
# ─────────────────────────────────────────────────────────────────────────────
FROM rust:${RUST_VERSION}-slim-bookworm AS rust-gen
COPY --from=protoc /usr/local/bin/protoc /usr/local/bin/protoc
COPY --from=protoc /usr/local/include/google /usr/local/include/google
WORKDIR /src
COPY codegen/Cargo.toml codegen/Cargo.lock codegen/
COPY codegen/src codegen/src
COPY proto/ proto/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/codegen/target \
    cd codegen && cargo run --release --locked

# ─────────────────────────────────────────────────────────────────────────────
# What `make codegen` extracts
# ─────────────────────────────────────────────────────────────────────────────
FROM scratch AS export
COPY --from=python-gen /out/python /python
COPY --from=rust-gen /out/rust /rust
